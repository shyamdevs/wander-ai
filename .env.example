# Public API URL (never put secrets here: Vite embeds VITE_* values in browser JavaScript).
#
# Two-project Vercel deployment (recommended: same-site custom domains such as app.<yours> + api.<yours>):
#   VITE_API_URL=https://<your-backend-host>/api
# The Content-Security-Policy connect-src is generated from this value at build time, so no manual
# edit of vercel.json is needed for a custom API domain.
#
# Same-origin proxy mode (advanced, see docs/DEPLOYMENT.md section 3b): VITE_API_URL=/api
# Local development: leave empty; Vite proxies /api to http://localhost:5000.
VITE_API_URL=
